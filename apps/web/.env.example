# Copy to apps/web/.env for local development.
# Vite exposes VITE_* variables to the browser, so never put secrets here.

# Base path of the API. In dev, Vite proxies /api to http://localhost:4000.
VITE_API_URL=/api/v1

# Public origin used in canonical and Open Graph URLs. Leave empty to use the current host.
VITE_SITE_URL=
