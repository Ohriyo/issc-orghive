# Copy to apps/api/.env for local development. These values match docker-compose.yml.
# They are local-only development credentials, not real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Only this origin may call the API from a browser (CORS).
WEB_ORIGIN=http://localhost:5173
# Reverse proxies in front of the API (hop count or subnet), so per-IP login limits see the
# client's address. "false" when the API is reached directly. Never "true".
TRUST_PROXY=false

# Ed25519 keys that sign access tokens (EdDSA). Generate a pair per environment:
#   pnpm --filter api keys:generate >> apps/api/.env
# Keep the private key secret; it is never committed.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Postgres (docker compose service "postgres")
DATABASE_URL=postgresql://orghive:orghive-dev-password@localhost:5433/orghive

# Redis (docker compose service "redis")
REDIS_URL=redis://localhost:6379

# S3-compatible storage (docker compose service "minio"; console at http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orghive
S3_ACCESS_KEY=orghive
S3_SECRET_KEY=orghive-dev-password
S3_FORCE_PATH_STYLE=true
# Public base URL for organization logos. Only the logos/ prefix is anonymously readable
# (see minio-init in docker-compose.yml); documents stay private. Point at a CDN in production.
PUBLIC_ASSET_BASE_URL=http://localhost:9000/orghive

# Storage URL the browser uses for pre-signed uploads and downloads, when it differs from
# S3_ENDPOINT (e.g. the API reaches MinIO inside a container network). Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=

# Virus scanning (docker compose service "clamav"): the worker streams uploads to clamd.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Email (docker compose service "mailpit"; inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@orghive.local
# Production relays: SMTP_SECURE=true for port 465 (implicit TLS); set credentials if required.
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Password for the seeded development accounts (pnpm --filter api db:seed). Min 12 characters.
# Dev-only: never reuse a real password here.
SEED_PASSWORD=change-me-dev-only

# Separate database for repository tests (created and migrated automatically by the tests).
DATABASE_URL_TEST=postgresql://orghive:orghive-dev-password@localhost:5433/orghive_test
# Redis for API tests. Use a separate logical database: the tests flush it.
REDIS_URL_TEST=redis://localhost:6379/15
