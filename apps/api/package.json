{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start:worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx --env-file-if-exists=.env scripts/demo-data.ts seed",
    "db:unseed:demo": "tsx --env-file-if-exists=.env scripts/demo-data.ts unseed",
    "check:no-demo": "tsx --env-file-if-exists=.env scripts/check-no-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "keys:generate": "tsx scripts/generate-jwt-keys.ts",
    "create-super-admin": "tsx --env-file-if-exists=.env scripts/create-super-admin.ts",
    "load:sse": "tsx --env-file-if-exists=.env scripts/load-sse.ts",
    "pages:backfill": "tsx --env-file-if-exists=.env scripts/backfill-previews.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@fontsource/poppins": "^5.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "@orghive/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.15",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.1",
    "otplib": "13.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright-core": "1.64.0",
    "qrcode": "1.5.4",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "5.0.4",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
